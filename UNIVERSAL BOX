#include <ESP8266WiFi.h>
#include <PubSubClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <EEPROM.h>

// --- WAVE CONTROL CLOUD CONFIGURATION ---
const char* mqtt_server = "o2b77a12.ala.eu-central-1.emqxsl.com";
const int mqtt_port = 8883; // Secure TLS Port

const char* mqtt_user = "smartglove";
const char* mqtt_pass = "Smartw@04";

WiFiClientSecure espClient;
PubSubClient client(espClient);

// --- LCD & HARDWARE PINS (NodeMCU Mapping) ---
LiquidCrystal_I2C lcd(0x27, 16, 2);

const int FAN_RELAY = 12;   // D6 
const int LIGHT_RELAY = 14; // D5 
const int RED_LED = 13;     // D7 
const int YELLOW_LED = 16;  // D0 

String serialInput = "";

// Robust Timers and State Trackers
unsigned long lcdTimer = 0;
unsigned long lastWiFiCheck = 0;
unsigned long lastMqttCheck = 0;
unsigned long lastLedToggle = 0;

bool lcdCustomActive = false;
int lastSystemState = -1; // 0 = No WiFi, 1 = No Cloud, 2 = Online

void setupHardware() {
  // PREVENT RELAY GLITCHES: Set HIGH (OFF) before setting as OUTPUT
  digitalWrite(FAN_RELAY, HIGH);
  digitalWrite(LIGHT_RELAY, HIGH);
  digitalWrite(RED_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);

  pinMode(FAN_RELAY, OUTPUT);
  pinMode(LIGHT_RELAY, OUTPUT);
  pinMode(RED_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);

  Wire.begin(4, 5);

  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("WAVE CONTROL");
  lcd.setCursor(0, 1);
  lcd.print("System Ready");

  // Visual Boot Sequence
  for (int i = 0; i < 3; i++) {
    digitalWrite(RED_LED, HIGH);
    digitalWrite(YELLOW_LED, LOW);
    delay(150);
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, HIGH);
    delay(150);
  }
  digitalWrite(YELLOW_LED, LOW);
}

void flashRedLED() {
  for (int i = 0; i < 2; i++) {
    digitalWrite(RED_LED, HIGH);
    delay(100);
    digitalWrite(RED_LED, LOW);
    delay(100);
  }
}

void showLCDMessage(String line1, String line2 = "") {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(line1);
  if (line2 != "") {
    lcd.setCursor(0, 1);
    lcd.print(line2);
  }
  lcdTimer = millis();
  lcdCustomActive = true;
}

void executeCommand(String command) {
  command.trim();
  flashRedLED();

  if (command == "LIGHT_ON") {
    digitalWrite(LIGHT_RELAY, LOW);  // Active-LOW: LOW = ON
    showLCDMessage("Light: ON");
  } 
  else if (command == "LIGHT_OFF") {
    digitalWrite(LIGHT_RELAY, HIGH); // Active-LOW: HIGH = OFF
    showLCDMessage("Light: OFF");
  } 
  else if (command == "FAN_ON") {
    digitalWrite(FAN_RELAY, LOW);    
    showLCDMessage("Fan: ON");
  } 
  else if (command == "FAN_OFF") {
    digitalWrite(FAN_RELAY, HIGH);   
    showLCDMessage("Fan: OFF");
  } 
  else if (command.startsWith("TEXT:")) {
    String customText = command.substring(5);
    showLCDMessage(customText);
  } 
  else {
    showLCDMessage("Unknown Cmd");
  }
}

// --- CRASH-PROOF EEPROM STORAGE ---
void saveCredentials(String ssid, String pass) {
  EEPROM.begin(512);
  
  // Guard against string lengths exceeding limits
  if (ssid.length() > 31) ssid = ssid.substring(0, 31);
  if (pass.length() > 63) pass = pass.substring(0, 63);

  EEPROM.write(0, ssid.length());
  for (unsigned int i = 0; i < ssid.length(); ++i) {
    EEPROM.write(1 + i, ssid[i]);
  }
  
  int passIndex = 33;
  EEPROM.write(32, pass.length());
  for (unsigned int i = 0; i < pass.length(); ++i) {
    EEPROM.write(passIndex + i, pass[i]);
  }
  
  EEPROM.commit();
  EEPROM.end();
}

String getStoredSSID() {
  EEPROM.begin(512);
  int len = EEPROM.read(0);
  String ssid = "";
  if (len > 0 && len <= 31) {
    for (int i = 0; i < len; ++i) {
      ssid += (char)EEPROM.read(1 + i);
    }
  }
  EEPROM.end();
  return ssid;
}

String getStoredPassword() {
  EEPROM.begin(512);
  int len = EEPROM.read(32);
  String pass = "";
  if (len > 0 && len <= 63) {
    int passIndex = 33;
    for (int i = 0; i < len; ++i) {
      pass += (char)EEPROM.read(passIndex + i);
    }
  }
  EEPROM.end();
  return pass;
}

void triggerWiFiConnect() {
  String ssid = getStoredSSID();
  String pass = getStoredPassword();

  // Fallback defaults if memory is wiped or empty
  if (ssid.length() == 0 || ssid.length() > 31) {
    ssid = "POCO X7 Pro";
    pass = "987654321";
  }

  WiFi.mode(WIFI_STA);
  WiFi.disconnect(); // Clear bad states before reconnecting
  delay(100);
  WiFi.begin(ssid.c_str(), pass.c_str());
}

void attemptMQTTConnect() {
  String clientId = "WaveControlBox-";
  clientId += String(ESP.getChipId(), HEX);
  
  if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
    client.subscribe("astroreach/box/control");
    showLCDMessage("Cloud Connected!");
  }
}

void callback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (unsigned int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  executeCommand(message);
}

int getSystemState() {
  if (WiFi.status() != WL_CONNECTED) return 0; // Offline
  if (!client.connected()) return 1;           // Local network only
  return 2;                                    // Fully Online
}

void setup() {
  Serial.begin(115200);
  delay(500); // Allow power rails to stabilize

  setupHardware();
  triggerWiFiConnect();

  espClient.setInsecure(); // Ignore SSL certificates for faster, generic TLS link
  espClient.setTimeout(5000); // Prevent blocking if broker drops packets
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

void loop() {
  // 1. Buffer Overflow & Dynamic Credential Protection
  while (Serial.available() > 0) {
    char incomingChar = Serial.read();
    if (incomingChar == '\n' || incomingChar == '\r') {
      if (serialInput.length() > 0) {
        serialInput.trim();
        int commaIndex = serialInput.indexOf(',');
        if (commaIndex > 0) {
          String newSsid = serialInput.substring(0, commaIndex);
          String newPass = serialInput.substring(commaIndex + 1);
          newSsid.trim();
          newPass.trim();
          
          saveCredentials(newSsid, newPass);
          showLCDMessage("Wi-Fi Saved!", "Rebooting...");
          delay(1500);
          ESP.restart();
        } else {
          executeCommand(serialInput);
        }
        serialInput = ""; 
      }
    } else {
      serialInput += incomingChar;
      if (serialInput.length() > 100) serialInput = ""; // Prevent memory crash from garbage data
    }
  }

  // 2. Fetch System State
  int currentState = getSystemState();

  // 3. LED Behavior
  if (currentState == 2) {
    digitalWrite(YELLOW_LED, HIGH); 
  } else {
    // Non-blocking half-second blink for connection issues
    if (millis() - lastLedToggle > 500) {
      digitalWrite(YELLOW_LED, !digitalRead(YELLOW_LED));
      lastLedToggle = millis();
    }
  }

  // 4. Autonomous Recovery Mechanics (Retry every 5 seconds)
  if (currentState == 0) {
    if (millis() - lastWiFiCheck > 5000) {
      triggerWiFiConnect();
      lastWiFiCheck = millis();
    }
  } else if (currentState == 1) {
    if (millis() - lastMqttCheck > 5000) {
      attemptMQTTConnect();
      lastMqttCheck = millis();
    }
  }

  // 5. Clear Temporary Commands from LCD
  if (lcdCustomActive && (millis() - lcdTimer > 10000)) {
    lcdCustomActive = false;
    lastSystemState = -1; // Force a UI refresh
  }

  // 6. Dynamic Standby UI Update
  if (!lcdCustomActive && (currentState != lastSystemState)) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("WAVE CONTROL");
    lcd.setCursor(0, 1);
    
    if (currentState == 0) {
      lcd.print("No WiFi Link");
    } else if (currentState == 1) {
      lcd.print("No Cloud Link");
    } else if (currentState == 2) {
      lcd.print("Cloud Online");
    }
    
    lastSystemState = currentState; 
  }

  // 7. Keep Cloud Ping Active
  if (currentState == 2) {
    client.loop();
  }
}
